---
import '../styles/global.css';
import Header from '../components/Header.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ti passo un Excel',
  description,
} = Astro.props as Props;

const path = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || 'La raccolta dei fogli Excel dei nostri viaggi — condivisi con chi li ha vissuti.'} />
    <link rel="icon" href="/logo.png" type="image/png" />
    <title>{title} · Ti passo un Excel</title>
  </head>
  <body>
    <Header />
    {description && (
      <div class="formula-bar-hero expanded" id="formula-bar">
        <span class="fb-fx">fx</span>
        <div class="fb-sep"></div>
        <span class="fb-value">{description}</span>
        <button class="fb-chevron" id="fb-toggle" aria-label="Comprimi descrizione">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    )}
    <slot />
    <div class="sheet-tabs-bar">
      <a href="/" class={`sheet-tab${path === '/' || path.startsWith('/viaggi') ? ' active' : ''}`}>Homepage</a>
      <a href="/privacy" class={`sheet-tab${path === '/privacy' ? ' active' : ''}`}>Privacy Policy</a>
      <a href="https://www.andrearapuzzi.com" target="_blank" rel="noopener" class="sheet-tab">About me</a>
    </div>
  </body>
</html>

<script>
  const bar = document.getElementById('formula-bar');
  const btn = document.getElementById('fb-toggle');
  if (bar && btn) {
    btn.addEventListener('click', () => {
      bar.classList.toggle('expanded');
    });
  }
</script>
