---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  formulaBar?: string;
  cellRef?: string;
}

const {
  title = 'Ti passo un Excel',
  formulaBar,
  cellRef = 'A1',
} = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="La raccolta dei fogli Excel dei nostri viaggi — condivisi con chi li ha vissuti." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Ti passo un Excel</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <div class="sheet-tabs-bar">
      <a href="/" class="sheet-tab active">Ti passo un Excel</a>
      <a href="/privacy" class="sheet-tab">Privacy Policy</a>
      <a href="/about" class="sheet-tab">About me</a>
    </div>
  </body>
</html>
