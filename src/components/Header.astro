---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <!-- Top bar: icon + file title + actions -->
  <div class="header-topbar">
    <div class="header-left"></div>
    <div class="header-title">Ti passo un Excel</div>
    <div class="header-right">
      <a href="/viaggi" class="header-icon-btn" title="Condividi">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Ribbon tabs -->
  <nav class="header-ribbon">
    <a href="/" class={`ribbon-tab${currentPath === '/' ? ' active' : ''}`}>Home</a>
    <a href="/viaggi" class={`ribbon-tab${currentPath.startsWith('/viaggi') ? ' active' : ''}`}>I Viaggi</a>
  </nav>
</header>
