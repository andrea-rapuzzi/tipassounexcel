---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">
    <a href="/" class="header-logo">
      <div class="logo-icon">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="18" height="18" fill="#217346" rx="1"/>
          <rect x="1" y="1" width="16" height="16" fill="white" rx="1"/>
          <line x1="1" y1="7" x2="17" y2="7" stroke="#217346" stroke-width="0.8"/>
          <line x1="1" y1="11" x2="17" y2="11" stroke="#217346" stroke-width="0.8"/>
          <line x1="6" y1="1" x2="6" y2="17" stroke="#217346" stroke-width="0.8"/>
          <line x1="12" y1="1" x2="12" y2="17" stroke="#217346" stroke-width="0.8"/>
          <rect x="1" y="1" width="5" height="6" fill="#217346" opacity="0.9"/>
          <text x="2" y="6.5" font-size="4" fill="white" font-family="Arial" font-weight="bold">X</text>
        </svg>
      </div>
      <span>Ti passo un Excel</span>
    </a>
    <nav>
      <ul>
        <li>
          <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
        </li>
        <li>
          <a href="/viaggi" class={currentPath.startsWith('/viaggi') ? 'active' : ''}>
            I Viaggi
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
