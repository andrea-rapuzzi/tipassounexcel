---
import Layout from '../../layouts/Layout.astro';
import { getTrips } from '../../lib/sheets.js';

export async function getStaticPaths() {
  const trips = await getTrips();
  return trips.map((trip) => ({
    params: { slug: trip.slug },
    props: { trip },
  }));
}

const { trip } = Astro.props;

const tipoBadge: Record<string, string> = {
  Mare: 'badge-mare', Montagna: 'badge-montagna', Città: 'badge-citta',
  Roadtrip: 'badge-roadtrip', Natura: 'badge-natura', Cultura: 'badge-cultura',
  Trekking: 'badge-trekking', Relax: 'badge-relax', Avventura: 'badge-avventura',
};

const emoji = trip.emoji || '✈️';

const costoPerPersona = trip.costo_persona
  ? new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(Number(trip.costo_persona))
  : '—';

const dataFormatted = trip.data
  ? new Date(trip.data).toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })
  : '—';

const tipiList = trip.tipo ? trip.tipo.split(',').map((s: string) => s.trim()) : [];
---

<Layout title={trip.titolo} description={trip.descrizione}>

  <!-- Breadcrumb giallino stile Excel -->
  <section class="trip-page-header">
    <div class="container">
      <span class="trip-page-breadcrumb">
        <a href="/">Home</a> › <a href="/viaggi">I Viaggi</a> › {trip.titolo}
      </span>
    </div>
  </section>

  <!-- Tabella Excel con i dati del viaggio -->
  <div class="xl-table-wrap">
    <table class="xl-table">
      <thead>
        <tr class="xl-col-letters">
          <th class="xl-th-rn"></th>
          <th class="xl-th-letter">A</th>
          <th class="xl-th-letter">B</th>
          <th class="xl-th-letter">C</th>
          <th class="xl-th-letter">D</th>
          <th class="xl-th-letter">E</th>
          <th class="xl-th-letter">F</th>
          <th class="xl-th-letter">G</th>
        </tr>
      </thead>
      <tbody>

        <!-- Riga 1: titolo viaggio -->
        <tr>
          <td class="xl-td xl-td-num">1</td>
          <td class="xl-td detail-label">Titolo</td>
          <td class="xl-td detail-value" colspan="2">
            <div class="detail-title">
              <span>{emoji}</span>
              <span>{trip.titolo}</span>
            </div>
          </td>
          <td class="xl-td"></td><td class="xl-td"></td>
          <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
        </tr>

        <!-- Riga 2: destinazione -->
        <tr>
          <td class="xl-td xl-td-num">2</td>
          <td class="xl-td detail-label">Destinazione</td>
          <td class="xl-td detail-value">📍 {trip.destinazione}</td>
          <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
          <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
        </tr>

        <!-- Riga 3: tipo -->
        <tr>
          <td class="xl-td xl-td-num">3</td>
          <td class="xl-td detail-label">Tipo</td>
          <td class="xl-td detail-value">
            <div class="xl-td-tags">
              {tipiList.map((tag: string) => (
                <span class={`badge ${tipoBadge[tag] || 'badge-altro'}`}>{tag}</span>
              ))}
            </div>
          </td>
          <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
          <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
        </tr>

        <!-- Riga 4: persone -->
        <tr>
          <td class="xl-td xl-td-num">4</td>
          <td class="xl-td detail-label">Persone</td>
          <td class="xl-td detail-value">👥 {trip.persone}</td>
          <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
          <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
        </tr>

        <!-- Riga 5: data -->
        {trip.data && (
          <tr>
            <td class="xl-td xl-td-num">5</td>
            <td class="xl-td detail-label">Data</td>
            <td class="xl-td detail-value">📅 {dataFormatted}</td>
            <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
            <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
          </tr>
        )}

        <!-- Riga 6: costo a persona -->
        {trip.costo_persona && (
          <tr>
            <td class="xl-td xl-td-num">6</td>
            <td class="xl-td detail-label">Costo a persona</td>
            <td class="xl-td detail-value costo-value">{costoPerPersona}</td>
            <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
            <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
          </tr>
        )}

        <!-- Righe vuote separatore -->
        {[8, 9].map((n) => (
          <tr class="xl-row-empty">
            <td class="xl-td-num">{n}</td>
            <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
            <td class="xl-td"></td><td class="xl-td"></td>
            <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
          </tr>
        ))}

        <!-- Riga 10: link file -->
        {(trip.link_sheet || trip.link_excel) && (
          <tr>
            <td class="xl-td xl-td-num">10</td>
            <td class="xl-td detail-label">File</td>
            <td class="xl-td detail-value" colspan="4">
              <div class="detail-actions">
                {trip.link_sheet && (
                  <a href={trip.link_sheet} target="_blank" rel="noopener" class="btn btn-green">
                    📊 Apri Google Sheet
                  </a>
                )}
                {trip.link_excel && (
                  <a href={trip.link_excel} class="btn btn-ghost">
                    ⬇️ Scarica XLS
                  </a>
                )}
              </div>
            </td>
            <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
          </tr>
        )}

        <!-- Righe vuote finali -->
        {Array.from({ length: 10 }).map((_, i) => (
          <tr class="xl-row-empty">
            <td class="xl-td-num">{(trip.link_sheet || trip.link_excel ? 11 : 10) + i}</td>
            <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
            <td class="xl-td"></td><td class="xl-td"></td>
            <td class="xl-td xl-td-empty"></td><td class="xl-td xl-td-empty"></td>
          </tr>
        ))}

      </tbody>
    </table>
  </div>

</Layout>

<style>
  .detail-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--text-muted);
    white-space: nowrap;
    min-width: 140px;
  }

  .detail-value {
    font-size: 0.9rem;
    color: var(--text);
  }

  .detail-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
  }

  .costo-value {
    font-weight: 700;
    color: var(--green);
  }

  .detail-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
