---
import Layout from '../../layouts/Layout.astro';
import { getTrips } from '../../lib/sheets.js';

const trips = await getTrips();

const tipi = [...new Set(trips.map((t) => t.tipo).filter(Boolean))].sort();
const personeOptions = [...new Set(trips.map((t) => t.persone).filter(Boolean))]
  .map(Number)
  .sort((a, b) => a - b);

const tipoEmoji: Record<string, string> = {
  Mare: '🏖️', Montagna: '⛰️', Città: '🏙️', Avventura: '🧗',
};
const tipoBadge: Record<string, string> = {
  Mare: 'badge-mare', Montagna: 'badge-montagna', Città: 'badge-citta',
};
---

<Layout title="I Viaggi" description={`Tutti i fogli Excel dei miei viaggi. ${trips.length} disponibili — usa i filtri per trovare quello che cerchi.`}>

  <!-- Filter bar — attaccata alla formula bar -->
  <div class="filter-bar">
    <div class="filter-dropdowns">
      <div class="filter-group">
        <label for="filter-tipo">Tipo</label>
        <select id="filter-tipo" class="filter-select">
          <option value="">Tutti</option>
          {tipi.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
      <div class="filter-group">
        <label for="filter-persone">Persone</label>
        <select id="filter-persone" class="filter-select">
          <option value="">Tutte</option>
          {personeOptions.map((n) => (
            <option value={String(n)}>{n} {n === 1 ? 'persona' : 'persone'}</option>
          ))}
        </select>
      </div>
      <div class="filter-group">
        <label for="sort-by">Ordina</label>
        <select id="sort-by" class="filter-select">
          <option value="data-desc">Più recenti</option>
          <option value="data-asc">Più vecchi</option>
          <option value="costo-asc">Costo ↑</option>
          <option value="costo-desc">Costo ↓</option>
          <option value="dest-asc">Destinazione A→Z</option>
        </select>
      </div>
    </div>
    <div class="filter-actions">
      <span class="filter-count" id="count-label">{trips.length} viaggi</span>
      <button id="reset-filters" class="btn btn-ghost" style="font-size:0.82rem; padding:6px 12px;">
        ✕ Azzera filtri
      </button>
    </div>
  </div>

  <!-- Tabella Excel -->
  <div class="xl-table-wrap">
    <table class="xl-table">
      <thead>
        <!-- Riga lettere colonna (stile Excel) -->
        <tr class="xl-col-letters">
          <th class="xl-th-rn"></th>
          <th class="xl-th-letter">A</th>
          <th class="xl-th-letter">B</th>
          <th class="xl-th-letter">C</th>
          <th class="xl-th-letter">D</th>
        </tr>
        <!-- Riga intestazioni contenuto -->
        <tr>
          <th class="xl-th xl-th-num"></th>
          <th class="xl-th">Destinazione</th>
          <th class="xl-th">Tipo</th>
          <th class="xl-th">Persone</th>
          <th class="xl-th">Costo tot.</th>
        </tr>
      </thead>
      <!-- tbody dati: 2 righe vuote + righe viaggio (manipolato dal JS) -->
      <tbody id="trips-body">
        <tr class="xl-row-empty">
          <td class="xl-td-num">1</td>
          <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
        </tr>
        <tr class="xl-row-empty">
          <td class="xl-td-num">2</td>
          <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
        </tr>
        {trips.map((trip, i) => (
          <tr
            class="trip-card-wrapper"
            data-tipo={trip.tipo}
            data-persone={trip.persone}
            data-costo={trip.costo}
            data-data={trip.data}
            data-dest={trip.destinazione}
          >
            <td class="xl-td xl-td-num">{i + 3}</td>
            <td class="xl-td xl-td-title">
              <span class="xl-emoji">{tipoEmoji[trip.tipo] || '✈️'}</span>
              {trip.titolo}
            </td>
            <td class="xl-td">
              <span class={`badge ${tipoBadge[trip.tipo] || 'badge-altro'}`}>{trip.tipo}</span>
            </td>
            <td class="xl-td">👥 {trip.persone}</td>
            <td class="xl-td xl-td-costo">
              {trip.costo
                ? new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(Number(trip.costo))
                : '—'}
            </td>
          </tr>
        ))}
      </tbody>
      <!-- tbody righe vuote finali: sempre in fondo, non toccate dal JS -->
      <tbody id="empty-rows">
        {Array.from({ length: 50 - 2 - trips.length }).map((_, i) => (
          <tr class="xl-row-empty">
            <td class="xl-td-num">{2 + trips.length + i + 1}</td>
            <td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td><td class="xl-td"></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div id="empty-filtered" class="empty-state" style="display:none;">
    <div class="empty-icon">🔍</div>
    <p>Nessun viaggio corrisponde ai filtri selezionati.</p>
    <button onclick="document.getElementById('reset-filters').click()" class="btn btn-ghost" style="margin-top:12px;">
      Azzera filtri
    </button>
  </div>

</Layout>

<script>
  const tipoSel    = document.getElementById('filter-tipo') as HTMLSelectElement;
  const personeSel = document.getElementById('filter-persone') as HTMLSelectElement;
  const sortSel    = document.getElementById('sort-by') as HTMLSelectElement;
  const resetBtn   = document.getElementById('reset-filters') as HTMLButtonElement;
  const countLabel = document.getElementById('count-label') as HTMLSpanElement;
  const emptyMsg   = document.getElementById('empty-filtered') as HTMLDivElement;
  const tbody      = document.getElementById('trips-body') as HTMLTableSectionElement;

  function getRows() {
    return Array.from(tbody.querySelectorAll('.trip-card-wrapper')) as HTMLTableRowElement[];
  }

  function applyFilters() {
    const tipo    = tipoSel.value;
    const persone = personeSel.value;
    const sort    = sortSel.value;

    const rows = getRows();

    rows.forEach((r) => {
      const match = (!tipo || r.dataset.tipo === tipo) && (!persone || r.dataset.persone === persone);
      r.style.display = match ? '' : 'none';
    });

    const visible = rows.filter((r) => r.style.display !== 'none');

    visible.sort((a, b) => {
      if (sort === 'costo-asc')  return Number(a.dataset.costo) - Number(b.dataset.costo);
      if (sort === 'costo-desc') return Number(b.dataset.costo) - Number(a.dataset.costo);
      if (sort === 'dest-asc')   return (a.dataset.dest || '').localeCompare(b.dataset.dest || '');
      if (sort === 'data-asc')   return (a.dataset.data || '').localeCompare(b.dataset.data || '');
      return (b.dataset.data || '').localeCompare(a.dataset.data || '');
    });

    visible.forEach((r) => tbody.appendChild(r));

    const count = visible.length;
    const total = rows.length;
    countLabel.textContent = count === total ? `${total} viaggi` : `${count} di ${total} viaggi`;
    emptyMsg.style.display = count === 0 ? 'block' : 'none';
  }

  tipoSel.addEventListener('change', applyFilters);
  personeSel.addEventListener('change', applyFilters);
  sortSel.addEventListener('change', applyFilters);

  resetBtn.addEventListener('click', () => {
    tipoSel.value    = '';
    personeSel.value = '';
    sortSel.value    = 'data-desc';
    applyFilters();
  });

  applyFilters();
</script>
