# URL CSV del Google Sheet pubblicato
# Come ottenerlo:
# 1. Apri il tuo Google Sheet
# 2. File → Condividi → Pubblica sul web
# 3. Scegli "Foglio1" e formato "Valori separati da virgola (.csv)"
# 4. Clicca "Pubblica" e copia il link
PUBLIC_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/PUBLISHED_ID/pub?output=csv

# Struttura attesa del Google Sheet (intestazioni nella riga 1):
# slug | destinazione | tipo | persone | costo | titolo | descrizione | link_sheet | link_excel | data
